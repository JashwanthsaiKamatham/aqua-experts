# ─────────────────────────────────────────────────────────────
# AQUA-EXPERTS — SERVER ENVIRONMENT (NEVER exposed to the browser)
# Copy this file to server/.env and fill in the real values.
# .env is git-ignored and never shipped to the client bundle.
# ─────────────────────────────────────────────────────────────

# Server
PORT=8080
NODE_ENV=development

# Comma separated list of allowed browser origins (CORS)
CLIENT_URL=http://localhost:5173
# Optional extra origins (preview deploys, custom domains)
EXTRA_ORIGINS=

# Supabase (service_role stays on the server ONLY)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection string — used only by `npm run db:setup` to create tables
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Google Gemini (backend only)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-latest
